      <aliases enabled='yes' />
      <column caption='Perfomance Score' datatype='integer' name='[Calculation_1077581565599744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]*[Review Scores Rating]' />
      </column>
      <column caption='Price Category' datatype='string' name='[Calculation_1077581567389697]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Price] &gt; 300 THEN &quot;LUXURY&quot;&#13;&#10;ELSEIF [Price]&gt; 150 THEN &quot;STANDARD&quot; &#13;&#10;ELSE &quot;BUDGET&quot; END' />
      </column>
      <column caption='Count of Hotels' datatype='integer' name='[Calculation_1077581570207747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Name])' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_1077581574123524]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since] &lt; TODAY()THEN&quot;ACTIVE HOST&quot; ELSE&quot;NEW HOST&quot; END' />
      </column>
      <column caption='REVIEW CATEGORY' datatype='string' name='[Calculation_1077581574946821]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Number Of Reviews]&gt;= 100 THEN &quot;HIGHELY REVIEWED&quot; ELSE&quot;LESS REVIEWED&quot; END' />
      </column>
      <column caption='PRICE FILTER CATEGORY' datatype='string' name='[Calculation_1077581576810503]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt; [Parameters].[Parameter 1077581575970822] THEN&quot;ABOVE LIMIT&quot; ELSE&quot;BELOW LIMIT&quot; END' />
      </column>
      <column caption='HOST SINCE_NEW' datatype='date' name='[Calculation_1077581583626249]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='REVIEW SCORE RATING NEW' datatype='string' name='[Calculation_1077581585920010]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(STR([Review Scores Rating (bin)]), &quot;NOT RATED&quot;)' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column datatype='integer' hidden='true' name='[Review Scores Rating (bin)]' role='measure' type='quantitative' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
